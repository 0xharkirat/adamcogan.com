SITE_URL=https://example.com

# TinaCloud, from app.tina.io. Either spelling of the client id is read.
TINA_CLIENT_ID=*** #Grab from TinaCloud app.tina.io
TINA_TOKEN=*** #Grab from TinaCloud app.tina.io

# Optional. Enables search INSIDE the CMS, so an editor can find one of 183
# posts without scrolling. This is a different token from TINA_TOKEN above:
# create it under API Tokens in the TinaCloud dashboard.
# It has nothing to do with the search on the public site, which Pagefind
# builds from the static HTML and needs no token. Leave this unset and the CMS
# simply has no search box.
# TINA_SEARCH_TOKEN=***

# Optional. Hosting platforms are auto-detected (Vercel, Cloudflare, Netlify → Node).
# Set this only to force an adapter for a local/manual deploy, e.g. `wrangler deploy`.
# DEPLOY_ADAPTER=cloudflare  # vercel | cloudflare | netlify | node

# Comments. Giscus renders only when all four are set; without them the site
# shows the migrated comment archive alone. Get the ids from https://giscus.app
# PUBLIC_GISCUS_REPO=owner/repo
# PUBLIC_GISCUS_REPO_ID=
# PUBLIC_GISCUS_CATEGORY=Comments
# PUBLIC_GISCUS_CATEGORY_ID=
