---
import { categoryName, tagName, type PostSummary } from '../lib/posts';

/**
 * The author / categories / tags / comments line under a post title.
 *
 * The original separates each group with a slash and joins items inside a
 * group with commas: "Adam Cogan / General, SSW Projects / best practice / 2 Comments".
 *
 * Separators are interleaved from an array rather than emitted inline in the
 * markup. JSX turns the newlines around an inline `{cond && ', '}` into real
 * whitespace, which renders as "General , SSW Projects".
 */
interface Props {
	post: PostSummary;
	/** Rendered as the trailing "N Comments" group when comments are known. */
	commentCount?: number;
	/** Anchor for the comment link. Falls back to the post URL. */
	commentHref?: string;
}

const { post, commentCount, commentHref } = Astro.props;

type Item = { href: string; label: string };
const groups: Item[][] = [];

if (post.author) groups.push([{ href: '', label: post.author }]);

const categories = post.categories.map((slug) => ({
	href: `/category/${slug}/`,
	label: categoryName(slug),
}));
if (categories.length) groups.push(categories);

const tags = post.tags.map((slug) => ({ href: `/tag/${slug}/`, label: tagName(slug) }));
if (tags.length) groups.push(tags);

if (typeof commentCount === 'number') {
	groups.push([
		{
			href: `${commentHref ?? post.url}#comments`,
			label: `${commentCount} ${commentCount === 1 ? 'Comment' : 'Comments'}`,
		},
	]);
}
---

<p class="mb-[7px] text-[0.9em] leading-normal">
	{groups.map((group, g) => (
		<>
			{g > 0 && <span class="mx-2 text-[#999]" aria-hidden="true">/</span>}
			<span>{group.map((item, i) => (<>{i > 0 ? ', ' : ''}{item.href ? <a href={item.href}>{item.label}</a> : item.label}</>))}</span>
		</>
	))}
</p>
