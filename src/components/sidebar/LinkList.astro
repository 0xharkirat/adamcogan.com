---
import { isExternalHref } from '../../lib/links';

/**
 * The link list shared by Adam's Profiles, Adam's Favourite Products, Recent
 * Posts and Archives. All four render identically on the live site.
 *
 * Row metrics are measured, not guessed: 16px text on a 22.4px line box with
 * 6px of padding above and below, giving the 34.4px row pitch the original has.
 * Links are #333 like body text and are marked only by a #CCC underline that
 * warms to the accent red on hover. Weight is forced to normal because the
 * original does the same with `#sidebar a { font-weight: normal }`.
 */
interface Props {
	items: { label: string; href: string }[];
}

const { items } = Astro.props;
---

<ul class="m-0 list-none p-0">
	{
		items.map((item) => {
			const external = isExternalHref(item.href);

			return (
				<li class="py-[6px] leading-[22.4px]">
					<a
						href={item.href}
						target={external ? '_blank' : undefined}
						rel={external ? 'noopener' : undefined}
						class="text-[16px] font-normal text-[#333] underline decoration-[#CCCCCC] hover:decoration-[#CC4141] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#CC4141]"
					>
						{item.label}
						{external && (
							<>
								<span class="external-marker" aria-hidden="true">↗</span>
								<span class="sr-only"> (opens in a new tab)</span>
							</>
						)}
					</a>
				</li>
			);
		})
	}
</ul>
