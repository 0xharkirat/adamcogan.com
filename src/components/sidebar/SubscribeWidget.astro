---
import WidgetHeading from './WidgetHeading.astro';
import sidebar from '../../data/sidebar.json';

const { title, body, placeholder, buttonLabel, action } = sidebar.subscribe;

/*
 * Sign-up posts to Kit.
 *
 * The original posted back to its own page, where the Jetpack plugin picked the
 * request up server side and validated a single-use `_wpnonce` stamped in at
 * render time. A static build can mint neither, which is why no endpoint was
 * invented here and `action` stayed null until a real one existed.
 *
 * Set `subscribe.action` in `src/data/sidebar.json` to a Kit form endpoint:
 *
 *   https://app.kit.com/forms/<FORM_ID>/subscriptions
 *
 * The form ID comes from the form's embed code in Kit, under Grow, Landing
 * Pages & Forms. Two things that look like details and are not:
 *
 *   1. The field must be named `email_address`. Called `email`, the request
 *      succeeds and Kit records nothing at all.
 *   2. Turn on double opt-in for the form, which is what Jetpack did. The
 *      confirmation message below promises an email, and imported subscribers
 *      are unaffected because an import arrives already confirmed.
 *
 * The full original form contract, every hidden input included, is still
 * recorded under `subscribe.originalForm` in that file.
 */
---

<section class="mb-[30px]" aria-labelledby="sidebar-subscribe-heading">
	<WidgetHeading id="sidebar-subscribe-heading">{title}</WidgetHeading>

	<p class="mb-[19.2px] text-[16px] leading-[24px] text-[#333]">{body}</p>

	<form method="post" action={action ?? '#'} data-subscribe data-wired={action ? 'true' : 'false'}>
		<div class="mb-[19.2px]">
			<label class="sr-only" for="sidebar-subscribe-email">Email Address</label>
			<input
				id="sidebar-subscribe-email"
				type="email"
				name="email_address"
				autocomplete="email"
				required
				placeholder={placeholder}
				class="w-[95%] rounded-[5px] border border-black/10 bg-[#F3F3F3] px-[10px] py-[6px] text-[16px] leading-[24px] text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#CC4141]"
			/>
		</div>

		<button
			type="submit"
			class="rounded-full bg-[#32373C] px-[23.328px] py-[12.672px] text-[16px] leading-[24px] font-normal text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#CC4141] disabled:cursor-not-allowed disabled:opacity-60"
		>
			{buttonLabel}
		</button>

		<p
			data-subscribe-note
			data-unwired="Email sign-up is not connected yet, so nothing was sent."
			role="status"
			aria-live="polite"
			hidden
			class="mt-[10px] text-[0.9em] leading-[24px] text-[#666]"
		>
		</p>
	</form>
</section>

{/*
  Submitting without leaving the page.

  Kit's public form endpoint sends `access-control-allow-origin: *`, so a fetch
  from this origin is allowed and the reader stays on the article they were
  reading. A native post would navigate them to a Kit confirmation page instead.

  The form keeps a real `action` and `method="post"` regardless, so it still
  works with JavaScript off, and the catch below falls back to that same native
  post if the fetch is blocked. Losing an address is worse than a page change.
*/}
<script is:inline>
	(function () {
		const form = document.querySelector('[data-subscribe]');
		if (!form) return;

		const note = form.querySelector('[data-subscribe-note]');
		const wired = form.dataset.wired === 'true';
		// Disabling the button stops a second click, but not a second submit:
		// Enter in the field and programmatic submits both bypass it, and each
		// one would be another sign-up request. Guard the handler itself.
		let inFlight = false;
		const say = (message) => {
			if (!note) return;
			note.textContent = message;
			note.hidden = false;
		};

		/*
		 * Stricter than `type="email"`, which follows the HTML spec and accepts
		 * `a@b` with no dot in the domain. That is a typo far more often than a
		 * real intranet address, and it would otherwise reach Kit and bounce.
		 * Same shape as EMAIL_RE in migration/scripts/7-subscribers.mjs, so the
		 * sign-up path and the import path agree on what an address is.
		 */
		const EMAIL = /^[^\s@,;]+@[^\s@,;]+\.[^\s@,;]+$/;

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (inFlight) return;

			if (!wired) {
				say(note ? note.dataset.unwired : '');
				return;
			}

			const input = form.querySelector('input[type="email"]');
			const button = form.querySelector('button[type="submit"]');
			const address = input.value.trim();

			if (!EMAIL.test(address)) {
				say('That does not look like a complete email address.');
				input.focus();
				return;
			}

			inFlight = true;
			if (button) button.disabled = true;
			say('Signing you up...');

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email_address: address }),
				});

				// A 4xx is a complaint about the address, so let the reader fix
				// it here. Reposting natively would only send the same bad value
				// again and dump them on an error page to do it.
				if (response.status >= 400 && response.status < 500) {
					say('That address was not accepted. Check it and try again.');
					return;
				}
				// Anything else that failed is our end, not theirs. Fall through
				// to the native post below rather than lose the address.
				if (!response.ok) throw new Error(String(response.status));

				form.reset();
				say('Thanks. Check your inbox to confirm your subscription.');
			} catch {
				// form.submit() does not re-fire this listener, so this is a
				// genuine native post rather than a loop.
				form.submit();
			} finally {
				inFlight = false;
				if (button) button.disabled = false;
			}
		});
	})();
</script>
