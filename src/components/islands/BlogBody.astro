---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsBlog } from '../../lib/data';
import type { PostSummary } from '../../lib/posts';
import FormattedDate from '../FormattedDate.astro';
import PostMeta from '../PostMeta.astro';
import { mdxComponents } from '../mdx/components';

/**
 * The body of a single post: hero, date, title, meta line, then the rich text.
 *
 * The title is 26px here, the same size as a listing title and smaller than a
 * bare h1 inside the body. That inconsistency is in the original and is
 * reproduced rather than tidied up.
 */
interface Props {
	data?: CmsBlog | null;
	/** Taxonomy for the meta line, already resolved by the route. */
	summary?: PostSummary;
}

const { data, summary } = Astro.props;
---

{data && (
	<article>
		{data.heroImage && (
			<div data-tina-field={tinaField(data, 'heroImage')} class="mb-[5px]">
				<img
					src={data.heroImage}
					alt=""
					width="670"
					height="241"
					fetchpriority="high"
					class="aspect-[670/241] w-full object-cover"
				/>
			</div>
		)}

		{data.pubDate && (
			<span data-tina-field={tinaField(data, 'pubDate')}>
				<FormattedDate date={new Date(data.pubDate)} />
			</span>
		)}

		{data.title && (
			<h1 data-tina-field={tinaField(data, 'title')} class="mt-0 mb-[5px] text-[26px] leading-[1.23] font-bold">
				{data.title}
			</h1>
		)}

		{summary && <PostMeta post={summary} commentCount={summary.commentCount} />}

		{data.body && (
			<div data-tina-field={tinaField(data, 'body')} class="entry">
				<TinaMarkdown content={data.body} components={mdxComponents} />
			</div>
		)}

		{data.updatedDate && (
			<p class="mt-8 text-[0.9em] italic">
				Last updated <FormattedDate date={new Date(data.updatedDate)} />
			</p>
		)}
	</article>
)}
