---
import type { CmsConfig } from '../lib/data';

/**
 * Footer: a back-to-top control above a hairline rule, then the credit line.
 * On the original the credit splits left and right and stacks on mobile.
 *
 * The right-hand credit is markup rather than a Global Config string because
 * it carries links, and the config collection is JSON, where a rich-text field
 * would be stored as an escaped blob and be worse to edit than this file. The
 * original had the same shape: "Powered by WordPress | Built by SSW", with the
 * builder linked.
 */
interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-[978px] px-[5%] xl:px-0">
	<div class="border-t border-[var(--color-hairline)] py-[30px]">
		<p class="mt-[-3px] mb-[1.2rem]">
			<a
				href="#top"
				aria-label="Back to top"
				class="inline-flex size-[30px] items-center justify-center rounded-full bg-black text-white no-underline transition-colors hover:bg-[var(--color-accent-red)]"
			>
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
					<path d="M5 15l7-7 7 7" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		</p>
		<div class="text-smallprint flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
			<p>
				&copy; <a href="/">{seo?.siteOwner}</a> {year}
			</p>
			{/*
			  Both credits open in a new tab so a reader is never navigated away
			  from an article. `rel="noopener"` is required with target="_blank",
			  and the sr-only note warns screen reader users before they follow a
			  link that changes context. `noreferrer` is deliberately omitted so
			  both sites still see the referral.
			*/}
			{/*
			  Kept on one line per link on purpose. A newline before `</a>` becomes
			  real whitespace inside the anchor, which renders as "TinaCMS , migrated".
			*/}
			<p>
				Migrated to{' '}
				<a href="https://tina.io" target="_blank" rel="noopener">TinaCMS<span class="sr-only"> (opens in a new tab)</span></a> by{' '}
				<a href="https://harksingh.com" target="_blank" rel="noopener">Harky<span class="sr-only"> (opens in a new tab)</span></a> with{' '}
				<span role="img" aria-label="love">❤️</span>
			</p>
		</div>
	</div>
</footer>
