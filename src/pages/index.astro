---
import Shell from '../layouts/Shell.astro';
import PostList from '../components/PostList.astro';
import { getConfig } from '../lib/data';
import { getPosts, paginate } from '../lib/posts';

/**
 * The homepage is the blog listing, as it is on the WordPress site.
 * Pages 2 and up live at /page/N/.
 */
const posts = await getPosts();
const page = paginate(posts, 1, '/');
const config = (await getConfig()).data?.config ?? null;
---

<Shell
	title={config?.seo?.title ?? 'Adam Cogan'}
	description={config?.seo?.description ?? ''}
>
	<PostList page={page} />
</Shell>
