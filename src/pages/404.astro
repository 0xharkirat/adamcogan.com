---
import Shell from '../layouts/Shell.astro';

/**
 * WordPress served a 404 through the same two-column template as everything
 * else, so this keeps the header, sidebar and footer rather than becoming a
 * full-bleed splash.
 */
---

<Shell title="Page not found" description="That page does not exist.">
	<h1 class="mb-[0.4em] text-[32px] leading-none font-semibold">Page not found</h1>
	<p class="mb-[1.2rem]">
		That page does not exist. It may have moved, or the link that brought you here may be wrong.
	</p>
	<p class="mb-[1.2rem]">
		Try the <a href="/">latest posts</a>, or search using the box in the sidebar.
	</p>
</Shell>
