---
import Shell from '../../layouts/Shell.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, paginate } from '../../lib/posts';

/**
 * /blog/ existed on WordPress as a second entry point to the same listing the
 * homepage shows, so it is kept rather than redirected. The empty WordPress
 * page of the same name was dropped during the content migration.
 */
const posts = await getPosts();
const page = paginate(posts, 1, '/blog/');
---

<Shell title="Blog" description="Posts by Adam Cogan.">
	<PostList page={page} />
</Shell>
